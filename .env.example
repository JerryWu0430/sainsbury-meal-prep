# copy to .env (local) or add as Vercel project env vars
OPENAI_API_KEY=
# SAINS_MODEL=openai:gpt-5.4-mini          # any openai:<model>; `test` = fake model, runs tools without a key
APP_PASSWORD=                              # dashboard login; unset locally = no login
AUTH_SECRET=                               # signs the login cookie: openssl rand -base64 32
# CRON_SECRET=                             # gates /api/warm (Vercel cron sends it automatically)
# SAINS_STORE=2499                         # default store code; find yours: sains stores "SE1 6TJ"
